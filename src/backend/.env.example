# MiniVault Environment Variables
# Copy this file to .env and fill in values before running

# Directory where runtime data (SQLite DB, vault config) is stored
VAULT_DATA_DIR=data/

# Session token HMAC signing secret — use a long random string in production
HMAC_SECRET=change-me-to-a-long-random-string

# Session TTL in minutes
SESSION_TTL_MINUTES=30

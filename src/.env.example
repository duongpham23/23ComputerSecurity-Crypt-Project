# Copy this file to .env and fill in real values before running docker compose.
# The .env file must never be committed to version control.

# ── JWT / Auth ─────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your actual domain, e.g. https://vault.example.com
CORS_ORIGINS=http://localhost:3000,http://frontend:80

# ── Database / Supabase ────────────────────────────────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# ── Frontend ───────────────────────────────────────────────────────────────────
# Host port the React app is exposed on.
FRONTEND_PORT=3000

# Vite build-time env var — baked into the JS bundle.
# Leave as /api/v1 when using the Nginx proxy (recommended).
# Set to a full URL only if the frontend and backend are on different domains.
VITE_API_BASE_URL=/api/v1
